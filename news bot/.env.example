# ==================================================
# Azure AI Foundry Agent Configuration (Research Agent)
# ==================================================
# Azure AI Foundry Project Endpoint URL
PROJECT_ENDPOINT=https://agentic-training2026.services.ai.azure.com/api/projects/Batch2026

# Azure AI Foundry Agent Name & Version
FOUNDRY_AGENT_NAME=ReevonAgent
FOUNDRY_AGENT_VERSION=5


# ==================================================
# Azure OpenAI / Foundry Model Endpoint (Summarizer & Reporter)
# ==================================================
# Endpoint URL (Base URL format supported)
AZURE_OPENAI_ENDPOINT=https://agentic-training2026.services.ai.azure.com/openai/v1

# API Key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# Model Deployment Name (e.g. gpt-5-mini, gpt-4o)
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# API Version (Optional when using base_url)
AZURE_OPENAI_API_VERSION=2024-08-01-preview
